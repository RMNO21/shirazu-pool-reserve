{
  "manifest_version": 3,
  "name": "Shiraz Pool Auto-Reserve",
  "version": "1.1.0",
  "description": "Fast auto-reservation bot for Shiraz University pool slots",
  "author": "Raman Tondro",
  "homepage_url": "https://github.com/RMNO21/shirazu-pool-reserve",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Shiraz Pool Auto-Reserve"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://sups.shirazu.ac.ir/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://sups.shirazu.ac.ir/SfxWeb/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
